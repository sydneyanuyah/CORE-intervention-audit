{
  "protocol": "a1_architecture_screening_v1",
  "registry": "registry/bert_scope.json",
  "stage": "screening",
  "model_size": "base",
  "seed_namespace": "a1-repaired-screening-v2",
  "seeds": [101, 102, 103, 104, 105],
  "families": {
    "xor": {"source": "xor", "two_edit": "authoritative_xor"},
    "ccrgb": {"source": "ccrgb", "two_edit": "authoritative_executable_boolean_scm"},
    "cladder": {"source": "cladder", "two_edit": "authoritative_executable_scm"},
    "wiqa": {"source": "wiqa", "two_edit": "authoritative_executable_signed_graph"},
    "com2": {"source": "com2", "two_edit": "authoritative_adjudicated_open_text"}
  },
  "arms": {
    "t0_id": {"mode": "t0", "pointer": false},
    "t1_text": {"mode": "t1", "pointer": false},
    "t2b_encode_only": {"mode": "t2b", "pointer": false},
    "t2a_naive": {"mode": "t2a", "pointer": false},
    "t3b_pointer": {"mode": "t3b", "pointer": true},
    "t3a_conditioning": {"mode": "t3a", "pointer": false}
  },
  "paths": {
    "data_root": "data",
    "groups_dir": "data/groups",
    "paraphrase_catalog": "data/paraphrases/structured_catalog_repaired.json",
    "cladder_artifact": "data/two_edit/cladder/artifact.json",
    "cladder_manifest": "data/two_edit/cladder/manifest.jsonl",
    "wiqa_queue": "data/two_edit/wiqa/queue.jsonl",
    "wiqa_truth": "data/two_edit/wiqa/truth.jsonl",
    "ccrgb_artifact": "data/two_edit/ccrgb/artifact.json",
    "ccrgb_manifest": "data/two_edit/ccrgb/manifest.jsonl",
    "com2_queue": "data/two_edit/manual/annotation_queue.jsonl",
    "com2_truth": "data/two_edit/manual/authoritative_manual_truth.jsonl",
    "com2_provenance": "data/two_edit/manual/authoritative_manual_truth.provenance.json",
    "xor_artifact_template": "${PRIVATE_STORAGE_ROOT}/CORE_joint_text_20graph/runs/graph_{graph}",
    "xor_manifest_template": "data/two_edit/xor_graph_{graph}.jsonl",
    "output_template": "outputs/a1-repaired/screening/{family}/{arm}/seed-{seed}",
    "xor_graphs": [3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008, 3009, 3010, 3011, 3012, 3013, 3014, 3015, 3016, 3017, 3018, 3019, 3020]
  },
  "training": {
    "epochs": 3,
    "batch_size": 16,
    "variable_loss_weight": 1.0,
    "balanced_variable_loss": true,
    "transition_variable_loss": true,
    "causal_task_readout": true,
    "pointer_loss_weight": 1.0
  }
}
